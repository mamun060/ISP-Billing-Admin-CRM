# Root project ignores

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editors and IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Environment files
.env
.env.*
**/.env
**/.env.*

# Frontend / Next.js
**/node_modules/
**/.next/
**/out/
**/build/
**/dist/
**/*.tsbuildinfo
**/coverage/
**/.cache/
**/.turbo/
**/.vercel/

# NPM / package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python / Django
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/*.pyd
**/.Python
**/venv/
**/.venv/
**/ENV/
**/env/
**/*.sqlite3
**/db.sqlite3
**/media/
**/staticfiles/
**/static/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/.coverage.*
**/coverage.xml
**/htmlcov/
**/*.egg-info/
**/.eggs/
**/.pyre/

# Python packaging
build/
dist/
*.egg-info/

# Local generated files
*.local
*.bak
*.tmp

# Optional: if you do not want generated Django migrations in git
# **/migrations/*.py
# !**/migrations/__init__.py
